# ── Frontend (safe to expose, these are public values) ───────────────────────
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-publishable-key

# Optional: base URL of your deployed app, used for OAuth redirects.
# Leave empty in local development (defaults to window.location.origin).
VITE_APP_URL=

# ── Supabase Edge Function secrets (NEVER put these in a VITE_ variable) ─────
# Set with: supabase secrets set NAME=value
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# APP_URL=https://your-app.pages.dev
# AI_PROVIDER=openai            # optional, leave unset to disable AI questions
# AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
